# ===================================================
# LAYERLAB 3D-Druck Studio — Konfiguration (.env)
# Kopiere diese Datei zu ".env" und trag deine Daten ein.
# ===================================================

# Server Port (Standard: 3001)
PORT=3001

# Öffentliche URL deiner Seite (wichtig für Stripe Rückleitungen im Live-Betrieb)
PUBLIC_URL=http://localhost:5173

# Optional: Initiale Admin-PIN fürs Creator Studio (Standard: 2026)
# Kannst du auch jederzeit direkt im Creator Studio ändern!
ADMIN_PIN=2026

# ===================================================
# KI FOTOSTUDIO (Handyfoto -> Dark-Studio Produktfoto via Gemini API)
# Kostenlosen Key holen unter https://aistudio.google.com/apikey
# Kannst du auch direkt im Creator Studio UI eintragen!
# ===================================================
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ===================================================
# STRIPE CHECKOUT (Echte Online-Zahlungen: Karte, Apple Pay, Klarna, SEPA)
# Hol dir deinen Secret Key unter https://dashboard.stripe.com/apikeys
# Ohne Key läuft der Shop automatisch im kostenlosen Demo-/Anfrage-Modus.
# ===================================================
STRIPE_SECRET_KEY=

# ===================================================
# AUTOMATISCHE BESTELL- & STATUS-E-MAILS (SMTP)
# Funktioniert mit Gmail App-Passwort, Strato, IONOS, Brevo, Resend etc.
# Ohne SMTP landen alle generierten E-Mails im Studio "E-Mail-Ausgang" als Vorschau.
# ===================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LAYERLAB 3D-Studio <deine@email.de>"

# ===================================================
# VERCEL BLOB STORAGE (Dauerhafter Cloud-Speicher auf Vercel für Uploads)
# Wird in Vercel automatisch gesetzt, sobald du unter Storage -> Blob aktivierst.
# ===================================================
BLOB_READ_WRITE_TOKEN=
AUTH_SECRET=
