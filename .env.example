# ===================================================
# Ano 3D-Druck Studio — Konfiguration (.env)
# Kopiere diese Datei zu ".env" (niemals auf GitHub committen!).
# ===================================================

# Server Port lokal (Standard: 3001)
PORT=3001

# Admin-PIN fürs Creator Studio
ADMIN_PIN=

# Zufälliger Secret-Key für Admin-Sessions & verschlüsselten Cloud-Vault
AUTH_SECRET=

# Vercel Blob Cloud-Speicher (Fotos, Produkte, .STL & verschlüsselte Aufträge)
BLOB_READ_WRITE_TOKEN=

# Optional: Google AI Studio Key für direkte KI-Bildgenerierung (erfordert API-Billing)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
